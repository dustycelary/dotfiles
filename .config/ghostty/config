# ==============================================================================
# GHOSTTY CONFIGURATION
# ==============================================================================
# Located at: ~/.config/ghostty/config
# Press `cmd+s` followed by `r` to reload this configuration after editing.

# ------------------------------------------------------------------------------
# 1. TYPOGRAPHY & FONTS
# ------------------------------------------------------------------------------
# font-family = IBM Plex Mono
# Fallback purely for Nerd Font icon glyphs Plex Mono doesn't have.
font-family = CommitMono Nerd Font
# font-family = VictorMono Nerd Font
# font-family = Iosevka Nerd Font Mono
# font-family = "Monaspace Argon NF"
# Monaspace ships Regular/Bold/Italic — leave font-style at default.
# NF build already includes Nerd Font icons.
# font-family = scientifica
# font-family = UbuntuMono Nerd Font

# font-size = 14

# font-family = Iosevka Fergus
# font-family-bold = "Iosevka Fergus"
# font-style-bold = "SemiBold"
# font-size = 14




# Monaspace is designed around texture-healing + ligatures — keep them on.
# Use -calt, -liga if you want explicit glyphs like Berkeley shot.
font-feature = calt
font-feature = liga

# Monaspace Regular is correct weight — keep crisp.
font-thicken = false

# Monaspace metrics are roomy already, no extra leading needed.
adjust-cell-height = 0%
adjust-cell-width = 0%
# adjust-icon-height = 30%

# Box and line-drawing symbol thickness adjustment
# adjust-box-thickness = 1

# Clean up underlines so they don't clash with descenders
# adjust-underline-position = 1
# adjust-underline-thickness = 1

# ------------------------------------------------------------------------------
# 2. THEMES & COLOR INTEGRATION
# ------------------------------------------------------------------------------
theme = Catppuccin Mocha

# Controls native macOS titlebar/scrollbar styling matching light/dark mode
window-theme = system

# Wider gamut colors on P3-capable displays (most Macs since ~2016)
window-colorspace = display-p3

# Floor for fg/bg contrast so dim theme colors stay legible through the
# background opacity/blur below
minimum-contrast = 1.1

# Bold text uses the bright palette color, not just extra weight
bold-color = bright

# ------------------------------------------------------------------------------
# 3. WINDOW AESTHETICS & LAYOUT
# ------------------------------------------------------------------------------
# Adjusting window appearance for a premium, modern feel.

# Initial window dimensions
window-width = 100
window-height = 28
window-save-state = never

# Spacing & margins (adds a modern, clean breathing room)
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

# Opacity and blur
background-opacity = 0.97
background-blur-radius = 20

macos-icon = holographic
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-window-shadow = false

# ------------------------------------------------------------------------------
# 4. TABS & MULTI-WINDOW BEHAVIOR
# ------------------------------------------------------------------------------
# Fade out unfocused split panes to emphasize your active workspace
unfocused-split-opacity = 0.75

# ------------------------------------------------------------------------------
# 5. CURSOR BEHAVIOR
# ------------------------------------------------------------------------------
cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true

# ------------------------------------------------------------------------------
# 6. SYSTEM & CLIPBOARD
# ------------------------------------------------------------------------------
scrollback-limit = 50000
shell-integration-features = no-cursor,sudo,no-title

copy-on-select = clipboard
clipboard-read = allow
macos-option-as-alt = true

# ------------------------------------------------------------------------------
# 7. QUICK TERMINAL (DROP-DOWN OVERLAY)
# ------------------------------------------------------------------------------
# Toggle with ctrl+alt+g from anywhere on macOS.
keybind = global:ctrl+alt+g=toggle_quick_terminal

# bottom, top, left, right
quick-terminal-position = right 
quick-terminal-size = 40%,100%
initial-window = true

# ------------------------------------------------------------------------------
# 8. KEYBINDINGS & WORKFLOW SHORTCUTS
# ------------------------------------------------------------------------------
# Custom tmux-like keybindings with leader key: cmd+s

# General Control
keybind = cmd+s>r=reload_config
keybind = cmd+s>x=close_surface
keybind = cmd+s>n=new_window
keybind = cmd+s>w=write_scrollback_file:open

# Tab Management
keybind = cmd+s>c=new_tab
keybind = cmd+s>shift+l=next_tab
keybind = cmd+s>shift+h=previous_tab
keybind = cmd+s>comma=move_tab:-1
keybind = cmd+s>period=move_tab:1
keybind = cmd+s>i=prompt_tab_title
keybind = cmd+s>shift+i=prompt_surface_title
keybind = cmd+shift+i=prompt_tab_title
keybind = cmd+shift+w=prompt_surface_title

# Tab Navigation (Quick Switch)
keybind = cmd+s>1=goto_tab:1
keybind = cmd+s>2=goto_tab:2
keybind = cmd+s>3=goto_tab:3
keybind = cmd+s>4=goto_tab:4
keybind = cmd+s>5=goto_tab:5
keybind = cmd+s>6=goto_tab:6
keybind = cmd+s>7=goto_tab:7
keybind = cmd+s>8=goto_tab:8
keybind = cmd+s>9=goto_tab:9

# Split Panes Layout
keybind = cmd+s>\=new_split:right
keybind = cmd+s>-=new_split:down

keybind = cmd+s>j=goto_split:bottom
keybind = cmd+s>k=goto_split:top
keybind = cmd+s>h=goto_split:left
keybind = cmd+s>l=goto_split:right

keybind = cmd+s>z=toggle_split_zoom
keybind = cmd+s>f=toggle_window_float_on_top
keybind = cmd+s>e=equalize_splits

# Split Panes Resizing (Leader cmd+s followed by ctrl + direction)
keybind = cmd+s>ctrl+h=resize_split:left,15
keybind = cmd+s>ctrl+j=resize_split:down,15
keybind = cmd+s>ctrl+k=resize_split:up,15
keybind = cmd+s>ctrl+l=resize_split:right,15
